# --- Database (SQLite for local dev; Supabase Postgres: postgresql+psycopg://user:pass@host:5432/postgres) ---
DATABASE_URL=sqlite:///./ledgerguard.db
# --- PayPal (leave blank => PAYPAL_MODE=mock) ---
# auto: sandbox when PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are both set, else mock. Force with mock|sandbox.
PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Leave blank to let PayPal use the REST app's sandbox business account email
MERCHANT_EMAIL=
MERCHANT_NAME=Chrisben Evans Leo
# --- LLM: auto-selects Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible, else deterministic fallback.
# ANTHROPIC_API_KEY lives in the process env (not this file). LLM_MODEL blank = claude-sonnet-5-5 / gpt-4o-mini. LLM_PROVIDER=anthropic|openai|none forces one.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# --- Web ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
